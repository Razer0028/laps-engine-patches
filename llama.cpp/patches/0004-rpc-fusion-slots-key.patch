+// ★時間の内訳（GGML_RPC_PROF=<N> のとき）。命令ごとの回数・時間・送受信の量を数え、計算の命令 N 回（既定 64）ごとに 1 行出す。
+// 親（client）は命令を送ってから返事を受け取るまで、子（server）は命令を受けてから片づけ終わるまでを数える。
+// 子は「次の命令を待っていた時間」も数える（親の GPU が計算している間など）。
+static const char * rpc_cmd_name(uint8_t cmd) {
+    static const char * names[] = {
+        "ALLOC_BUFFER", "GET_ALIGNMENT", "GET_MAX_SIZE", "BUFFER_GET_BASE", "FREE_BUFFER", "BUFFER_CLEAR",
+        "SET_TENSOR", "SET_TENSOR_HASH", "GET_TENSOR", "COPY_TENSOR", "GRAPH_COMPUTE", "GET_DEVICE_MEMORY",
+        "INIT_TENSOR", "GET_ALLOC_SIZE", "HELLO", "DEVICE_COUNT", "GRAPH_RECOMPUTE", "MEMSET_TENSOR",
+        "AUTH_CHALLENGE", "AUTH", "SET_TENSOR_STORE", "SET_TENSOR_SLOT",
+    };
+    static_assert(sizeof(names) / sizeof(names[0]) == RPC_CMD_COUNT, "rpc_cmd_name must list every command");
+    return cmd < RPC_CMD_COUNT ? names[cmd] : "?";
+}
+
+struct rpc_prof {
+    const char * side;
+    bool         on;
+    uint64_t     every;
+    std::mutex   mtx;
+    uint64_t     n[RPC_CMD_COUNT]   = {};
+    uint64_t     us[RPC_CMD_COUNT]  = {};
+    uint64_t     out[RPC_CMD_COUNT] = {};
+    uint64_t     in[RPC_CMD_COUNT]  = {};
+    uint64_t     idle_us  = 0;
+    uint64_t     computes = 0;
+    int64_t      t_start  = 0;
+    std::unordered_map<std::string, std::pair<uint64_t, uint64_t>> set_by_name; // 子: SET_TENSOR の名前ごとの回数と量
+
+    explicit rpc_prof(const char * side) : side(side) {
+        const char * e = std::getenv("GGML_RPC_PROF");
+        on    = e != nullptr;
+        every = (e && std::atoi(e) > 1) ? (uint64_t) std::atoi(e) : 64;
+    }
+
+    void add(uint8_t cmd, int64_t t_us, uint64_t bytes_out, uint64_t bytes_in) {
+        if (!on || cmd >= RPC_CMD_COUNT) {
+            return;
+        }
+        std::lock_guard<std::mutex> lock(mtx);
+        if (t_start == 0) {
+            t_start = ggml_time_us() - t_us;
+        }
+        n[cmd]++;
+        us[cmd]  += t_us;
+        out[cmd] += bytes_out;
+        in[cmd]  += bytes_in;
+        if (cmd == RPC_CMD_GRAPH_COMPUTE || cmd == RPC_CMD_GRAPH_RECOMPUTE) {
+            if (++computes >= every) {
+                dump_locked();
+            }
+        }
+    }
+
+    void add_set_name(const char * name, uint64_t bytes) {
+        if (!on) {
+            return;
+        }
+        std::lock_guard<std::mutex> lock(mtx);
+        auto & e = set_by_name[name];
+        e.first++;
+        e.second += bytes;
+    }
+
+    void add_idle(int64_t t_us) {
+        if (!on) {
+            return;
+        }
+        std::lock_guard<std::mutex> lock(mtx);
+        idle_us += t_us;
+    }
+
+    void dump_locked() {
+        if (computes == 0) {
+            return;
+        }
+        const double wall_ms = (ggml_time_us() - t_start) / 1000.0;
+        uint64_t busy = 0;
+        std::string s;
+        char buf[256];
+        for (int c = 0; c < RPC_CMD_COUNT; c++) {
+            if (n[c] == 0) {
+                continue;
+            }
+            busy += us[c];
+            snprintf(buf, sizeof(buf), " %s n=%.1f t=%.3fms out=%.1fKB in=%.1fKB;", rpc_cmd_name(c),
+                     (double) n[c] / computes, us[c] / 1000.0 / computes, out[c] / 1024.0 / computes, in[c] / 1024.0 / computes);
+            s += buf;
+        }
+        snprintf(buf, sizeof(buf), " | busy %.3fms idle %.3fms wall %.3fms", busy / 1000.0 / computes,
+                 idle_us / 1000.0 / computes, wall_ms / computes);
+        s += buf;
+        // llama-bench は ggml のログを捨てるので、標準エラーへ直に書く
+        if (!set_by_name.empty()) {
+            std::vector<std::pair<std::string, std::pair<uint64_t, uint64_t>>> v(set_by_name.begin(), set_by_name.end());
+            std::sort(v.begin(), v.end(), [](const auto & a, const auto & b) { return a.second.second > b.second.second; });
+            s += " | set:";
+            for (size_t i = 0; i < v.size() && i < 8; i++) {
+                snprintf(buf, sizeof(buf), " %s n=%.1f %.1fKB;", v[i].first.c_str(), (double) v[i].second.first / computes,
+                         v[i].second.second / 1024.0 / computes);
+                s += buf;
+            }
+            set_by_name.clear();
+        }
+        fprintf(stderr, "[rpc-prof %s] per compute (x%" PRIu64 "):%s\n", side, computes, s.c_str());
+        memset(n, 0, sizeof(n));
+        memset(us, 0, sizeof(us));
+        memset(out, 0, sizeof(out));
+        memset(in, 0, sizeof(in));
+        idle_us  = 0;
+        computes = 0;
+        t_start  = 0;
+    }
+};

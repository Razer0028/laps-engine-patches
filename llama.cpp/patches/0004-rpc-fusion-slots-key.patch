+static void rpc_auth_mac(const std::string & key, const char * label, const uint8_t nonce_s[32], const uint8_t nonce_c[32], uint8_t out[32]) {
+    const std::string l(label), ns((const char *) nonce_s, 32), nc((const char *) nonce_c, 32);
+    rpc_hmac_sha256(key, { &l, &ns, &nc }, out);
+}
+
+static bool rpc_mac_equal(const uint8_t * a, const uint8_t * b) {
+    uint8_t diff = 0;
+    for (int i = 0; i < 32; i++) {
+        diff |= a[i] ^ b[i];
+    }
+    return diff == 0;
+}

+// 鍵を読む。GGML_RPC_KEY_FILE が無ければ鍵なし（true・key は空）。あるのに読めない・短いときは false（繋がない・立ち上げない）。
+static bool rpc_load_key(std::string & key) {
+    key.clear();
+    const char * path = std::getenv("GGML_RPC_KEY_FILE");
+    if (path == nullptr || *path == '\0') {
+        return true;
+    }
+    std::ifstream f(path, std::ios::binary);
+    if (!f) {
+        GGML_LOG_ERROR("RPC: cannot read the key file %s\n", path);
+        return false;
+    }
+    key.assign(std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>());
+    while (!key.empty() && (key.back() == '\n' || key.back() == '\r' || key.back() == ' ' || key.back() == '\t')) {
+        key.pop_back();
+    }
+    if (key.size() < 16) {
+        GGML_LOG_ERROR("RPC: the key in %s is shorter than 16 bytes\n", path);
+        key.clear();
+        return false;
+    }
+    return true;
+}

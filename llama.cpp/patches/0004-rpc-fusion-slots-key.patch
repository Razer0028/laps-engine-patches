+// 接続ごとに作り直す（同じ住所に新しい接続ができても、前の接続の控えを使わない）
+static void rpc_set_reuse_reset(const socket_t * sock, bool supported) {
+    std::lock_guard<std::mutex> lock(rpc_set_reuse_mutex);
+    rpc_set_reuse_map.erase(sock);

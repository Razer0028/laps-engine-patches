+static void rpc_random_bytes(uint8_t * out, size_t n) {
+    std::random_device rd;
+    for (size_t i = 0; i < n; i += 4) {
+        const uint32_t v = rd();
+        memcpy(out + i, &v, std::min<size_t>(4, n - i));
+    }
+}

+static server_kvstore * kvstore_authorized(const server_http_req & req, server_http_res_ptr & err) {
+    auto * kv = server_kvstore::instance();
+    if (kv == nullptr || !kv->serving()) {
+        err = std::make_unique<server_http_res>();
+        err->status = 404;
+        err->data   = R"({"error":"sharing of stored prompts is off"})";

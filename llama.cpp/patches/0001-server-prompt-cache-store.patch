+#pragma once
+
+// on-disk and network tier for server_prompt_cache (L.A.P.S patch)
+//
+// entries evicted from the RAM prompt cache are written to a directory instead of being dropped,
+// and can be loaded back later - also after the server was restarted. the file holds everything
+// the RAM entry holds (tokens, context checkpoints, target and draft state), so a loaded entry
+// behaves exactly like a RAM hit.
+//
+// servers that run the same model can share their stored entries over HTTP (--cache-peers): when
+// a prompt is not cached locally, a peer that has it sends the file instead of the prompt being
+// processed again. the transfer needs a shared key because the file contains the conversation.
+
+#include "server-task.h"
+
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+struct server_kvstore_params {
+    std::string dir;
+
+    size_t limit_bytes = 0;    // 0 = no limit
+    int    min_tokens  = 4096; // smaller entries are cheap to recompute and are not written
+    int    keep_ckpt   = -1;   // keep only the newest N context checkpoints in a file (-1 = all)
+
+    std::vector<std::string> peers;    // base URLs of other servers, e.g. http://192.0.2.10:8741
+    std::string peer_key;              // shared secret; empty = no serving and no fetching
+    int         peer_max_kib_per_token = 32; // fetch only if the file is at most this big per token it saves
+};
+
+struct server_kvstore {
+    struct candidate {
+        std::string peer; // empty = local file
+        std::string id;
+        int    lcp    = 0;
+        float  f_keep = 0.0f;
+        float  f_sim  = 0.0f;
+        size_t bytes  = 0;
+    };
+
+    // fingerprint: model and cache parameters - a file is only used if it matches exactly
+    server_kvstore(const server_kvstore_params & params, std::string fingerprint);
+    ~server_kvstore();
+
+    // the store of this process, for the HTTP handlers (nullptr if there is none)
+    static server_kvstore * instance();
+
+    // take over an entry evicted from RAM; it is written in the background
+    void spill(server_prompt_cache_state && state);
+
+    // write an entry right now (used when the server exits)
+    void spill_sync(const server_prompt_cache_state & state);
+
+    // the stored entry that would preserve more context than (f_keep_best, f_sim_best), if any
+    bool find(const server_tokens & tokens_new, int lcp_best, float f_keep_best, float f_sim_best, candidate & out);
+
+    // the same, among the entries the peers have
+    bool find_remote(const server_tokens & tokens_new, int lcp_best, float f_keep_best, float f_sim_best, candidate & out);
+
+    // download a peer's entry into this store; afterwards read(c.id) works
+    bool fetch(const candidate & c);
+
+    // read an entry back into a cache state
+    bool read(const std::string & id, bool has_mtmd, server_prompt_cache_state & out);
+
+    // wait until all background writes are done
+    void flush();
+
+    // serving side
+    bool        serving() const { return !params.peer_key.empty(); }
+    bool        check_key(const std::string & key) const;
+    std::string index_json();
+    bool        blob_path(const std::string & id, std::string & path, size_t & size);
+
+private:
+    struct entry {
+        std::string  path;
+        llama_tokens tokens; // empty if the file belongs to another model
+        std::vector<uint64_t> hashes; // prefix hash after every block of tokens
+        size_t       bytes  = 0;
+        int64_t      t_used = 0;
+        bool         usable = false;
+    };
+
+    struct peer_entry {
+        std::string id;
+        size_t      n_tokens = 0;
+        size_t      bytes    = 0;
+        std::vector<uint64_t> hashes;
+    };
+
+    struct peer_state {
+        std::string url;
+        bool        fp_ok = false;
+        int64_t     t_ok  = 0;
+        std::vector<peer_entry> entries;
+    };
+
+    server_kvstore_params params;
+    std::string fingerprint;
+
+    std::mutex mtx;               // guards index
+    std::map<std::string, entry> index;
+

+// a later stage's image of a layer split: the same conversation and checkpoints, its own layer range, running state
+// and K/V (the last stage's holds one layer more, as with the draft layer's K/V)
+SavedConversation stage_sample(const SavedConversation& first, int stage, int layers) {
+    SavedConversation s;
+    s.geometry = first.geometry;
+    s.layer_lo = 48 * stage; s.layer_hi = 48 * (stage + 1);
+    s.cvec = first.cvec;
+    s.live = checkpoint(first.live.ids.size(), uint8_t(50 + stage));
+    s.live.imgs = first.live.imgs;
+    for (const auto& c : first.checkpoints) {
+        ConversationCheckpoint part = checkpoint(c.ids.size(), uint8_t(60 + stage));
+        part.imgs = c.imgs; part.used = c.used;
+        s.checkpoints.push_back(std::move(part));
+    }
+    for (int layer = 0; layer < layers; ++layer) {
+        ConversationKv kv;
+        kv.format = 7 + layer; kv.cells = 1024; kv.heads = 2; kv.head_dim = 256;
+        kv.page_size = 64; kv.pooled_rows = 9; kv.idx_dim = 128;
+        kv.k = pattern(8192 + size_t(stage), uint8_t(70 + stage + layer));
+        kv.v = pattern(4096 + size_t(layer), uint8_t(80 + stage + layer));
+        kv.k_scale = pattern(512, uint8_t(90 + stage));
+        kv.v_scale = pattern(layer == 0 ? 0 : 512, uint8_t(100 + stage));
+        kv.pooled = pattern(9 * 128 * 4, uint8_t(110 + stage));
+        s.kv.push_back(std::move(kv));
+    }
+    return s;
+}
+
+bool same_split(const SavedConversation& a, const SavedConversation& b) {
+    if (!same(a, b) || a.stage_images.size() != b.stage_images.size()) return false;
+    for (size_t k = 0; k < a.stage_images.size(); ++k)
+        if (!same(a.stage_images[k], b.stage_images[k]) || !b.stage_images[k].stage_images.empty()) return false;
+    return true;
+}

+// ---- W4 v1: down の TQ 行（K=40・8 レーン/行）。活性 hq を共有メモリの int4 並べにし、重みは「前の塊の最後のバイト」をシャッフルで・
+// 4 バイト境界の塊は 32 ビット 1 回読みで取る。warp 内の 4 行の番号の偶奇をそろえる（行 r の qs の境界は (r + 塊番号) が奇数のとき 4 バイト境界）。
+template<int TG, int NC>
+__device__ __forceinline__ float dn_tq_term(const TqLane& w, const int4* __restrict__ s_qs, const float* __restrict__ s_ds, int c, int blk, int t) {
+    const int4 qv = s_qs[(c * 20 + blk) * 2 + (t & 1)];
+    int sumi = 0;
+    sumi = ggml_cuda_dp4a(w.q[0], qv.x, sumi);
+    sumi = ggml_cuda_dp4a(w.q[1], qv.y, sumi);
+    sumi = ggml_cuda_dp4a(w.q[2], qv.z, sumi);
+    sumi = ggml_cuda_dp4a(w.q[3], qv.w, sumi);
+    return w.d * (s_ds[c * 20 + blk] * TQ_LUT_I8_SCALE) * (float) sumi;
+}
+template<int TG, int NC>
+__device__ __forceinline__ void dn_tq_pass(const uint8_t* __restrict__ wr, int rpar, const uint16_t* __restrict__ s_lut, const int4* __restrict__ s_qs,
+                                           const float* __restrict__ s_ds, int t, float (&s)[NC]) {
+    // k = t + 8*kb: 塊 kb、レーン t。hq の塊は kb*4 + t/2 でなく、row_dot_40_sub8 の x + kbx*(qk/32) + l/2 ＝ kb*4 + t/2（qk=128 → 4 つの q8_1）
+    const int hb = t >> 1;
+    TqLane w0 = tq_load_d<TG>(wr, 0, t, s_lut, ((0 + rpar) & 1) != 0);
+    TqLane w4 = tq_load_d<TG>(wr, 4, t, s_lut, ((4 + rpar) & 1) != 0);
+    TqLane w2 = tq_load_d<TG>(wr, 2, t, s_lut, ((2 + rpar) & 1) != 0);
+    TqLane w1 = tq_load_d<TG>(wr, 1, t, s_lut, ((1 + rpar) & 1) != 0);
+    TqLane w3 = tq_load_d<TG>(wr, 3, t, s_lut, ((3 + rpar) & 1) != 0);
+#pragma unroll
+    for (int c = 0; c < NC; ++c) {
+        float a = 0.0f;
+        a += dn_tq_term<TG, NC>(w0, s_qs, s_ds, c, 0 * 4 + hb, t);
+        a += dn_tq_term<TG, NC>(w4, s_qs, s_ds, c, 4 * 4 + hb, t);
+        float s16 = 0.0f;
+        s16 += dn_tq_term<TG, NC>(w2, s_qs, s_ds, c, 2 * 4 + hb, t);
+        a = __fadd_rn(a, s16);
+        float s8 = 0.0f;
+        s8 += dn_tq_term<TG, NC>(w1, s_qs, s_ds, c, 1 * 4 + hb, t);
+        float s24 = 0.0f;
+        s24 += dn_tq_term<TG, NC>(w3, s_qs, s_ds, c, 3 * 4 + hb, t);
+        a = __fadd_rn(a, __fadd_rn(s8, s24));
+#pragma unroll
+        for (int o = 4; o > 0; o >>= 1) a += __shfl_xor_sync(0xffffffffu, a, o);
+        s[c] = a;
+    }
+}
+template<int TG>
+__global__ void __launch_bounds__(256) native_down_tq_kernel(const unsigned long long* __restrict__ grp_ptr, const int32_t* __restrict__ grp_start,
+                                                             const int32_t* __restrict__ n_groups, const int32_t* __restrict__ ent_dst,
+                                                             const block_q8_1* __restrict__ hq, NativeExpertLayout L, float* __restrict__ out) {
+    const int ng = *n_groups;
+    if (blockIdx.y >= ng) return;
+    STRATA_SHARED_ALIGN16_U32(s_lut_buf, 1024);
+    __shared__ __align__(16) int4 s_qs[GRP_NC * 20 * 2];
+    __shared__ float s_ds[GRP_NC * 20];
+    const uint16_t* s_lut = (const uint16_t*) stage_iq_grid<TG, true>(s_lut_buf, threadIdx.x, 256);
+    const int sub = threadIdx.x >> 3, t = threadIdx.x & 7;
+    const int rin = (sub & 3) * 8 + (sub >> 2);     // 1 つの warp の 4 行は同じ偶奇（warp 番号 w = sub>>2、行 = 8q + w）
+    for (int g = blockIdx.y; g < ng; g += gridDim.y) {
+        const uint8_t* gp = (const uint8_t*) grp_ptr[g];
+        const float sd = L.tail_off ? ((const float*) (grp_ptr[g] + L.tail_off))[2] : 1.0f;
+        const int e0 = grp_start[g], e1 = grp_start[g + 1];
+        for (int e = e0; e < e1; e += GRP_NC) {
+            const int n = min(GRP_NC, e1 - e);
+            __syncthreads();
+            for (int u = threadIdx.x; u < n * 20; u += 256) {
+                const uint32_t* src = reinterpret_cast<const uint32_t*>(hq + (size_t) e * 20 + u);
+                const uint32_t dsw = src[0];
+                s_ds[u] = __low2float(*reinterpret_cast<const __half2*>(&dsw));
+                int4 a, bq;
+                a.x = (int) src[1]; a.y = (int) src[2]; a.z = (int) src[3]; a.w = (int) src[4];
+                bq.x = (int) src[5]; bq.y = (int) src[6]; bq.z = (int) src[7]; bq.w = (int) src[8];
+                s_qs[u * 2] = a; s_qs[u * 2 + 1] = bq;
+            }
+            __syncthreads();
+            for (int rc = blockIdx.x; rc * 32 < L.n_embd; rc += gridDim.x) {
+                const int r = rc * 32 + rin;
+                const uint8_t* wr = gp + L.down_off + (size_t) r * L.d_row;
+                const int rpar = r & 1;
+                if (n == 1) { float s1[1]; dn_tq_pass<TG, 1>(wr, rpar, s_lut, s_qs, s_ds, t, s1); if (t == 0) out[(size_t) ent_dst[e] * L.n_embd + r] = s1[0] * sd; }
+                else if (n == 2) { float s2[2]; dn_tq_pass<TG, 2>(wr, rpar, s_lut, s_qs, s_ds, t, s2); if (t < 2) out[(size_t) ent_dst[e + t] * L.n_embd + r] = s2[t] * sd; }
+                else if (n == 3) { float s3[3]; dn_tq_pass<TG, 3>(wr, rpar, s_lut, s_qs, s_ds, t, s3); if (t < 3) out[(size_t) ent_dst[e + t] * L.n_embd + r] = s3[t] * sd; }
+                else { float s4[4]; dn_tq_pass<TG, 4>(wr, rpar, s_lut, s_qs, s_ds, t, s4); if (t < 4) out[(size_t) ent_dst[e + t] * L.n_embd + r] = s4[t] * sd; }
+            }
+        }
+    }
+}

+// ---- W4 v1: gate/up の TQ 行（sub8）。活性（q8_1）を共有メモリへ 1 回だけ置き、qs は int4 並べ・ds は float 別配列にして、
+// 1 レーン・1 ステップの読みを LDG 5 回 → LDS.128 + LDS.32 にする。足し算の順・式は row_dot_160_sub8 と同じ。
+template<int TG>
+__device__ __forceinline__ TqLane tq_load_d(const uint8_t* __restrict__ row, int kbx, int t, const uint16_t* __restrict__ s_lut, bool wide) {
+    const auto* b = (const typename TqInfo<TG>::block_t*) row + kbx;
+    const uint16_t* qs16 = (const uint16_t*) b->qs;
+    uint32_t w01, w23;
+    if (wide) {
+        const uint32_t w = __ldg((const unsigned int*) (b->qs + 4 * t));
+        w01 = w & 0xFFFFu; w23 = w >> 16;
+    } else {
+        w01 = STRATA_TQ_LD16(qs16 + 2 * t + 0); w23 = STRATA_TQ_LD16(qs16 + 2 * t + 1);
+    }
+    const uint32_t b0 = w01 & 0xFF, b1 = w01 >> 8, b2 = w23 & 0xFF, b3 = w23 >> 8;
+    const uint32_t prev = (uint32_t) __shfl_sync(0xffffffffu, (int) b3, (t + 7) & 7, 8);
+    uint32_t st[4];
+    st[0] = (prev << 8) | b0; st[1] = (b0 << 8) | b1; st[2] = (b1 << 8) | b2; st[3] = (b2 << 8) | b3;
+    TqLane r;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const uint32_t x = (st[i] & TQ_STATE_MASK) * 0x9e3779b1u;
+        r.q[i] = (int) ((uint32_t) s_lut[x >> 21] | ((uint32_t) s_lut[(x >> 10) & 2047u] << 16));
+    }
+    r.d = tq_h2f(STRATA_TQ_LD16(&b->d));
+    return r;
+}
+template<int TG>
+__device__ __forceinline__ TqLane tq_load_f(const uint8_t* __restrict__ row, int kbx, int t, const uint16_t* __restrict__ s_lut, bool wide) {
+    const auto* b = (const typename TqInfo<TG>::block_t*) row + kbx;
+    const uint16_t* qs16 = (const uint16_t*) b->qs;
+    uint32_t w;
+    if (wide) w = __ldg((const unsigned int*) (b->qs + 4 * t));
+    else w = STRATA_TQ_LD16(qs16 + 2 * t + 0) | (STRATA_TQ_LD16(qs16 + 2 * t + 1) << 16);
+    const uint32_t prev = (uint32_t) __shfl_sync(0xffffffffu, (int) (w >> 24), (t + 7) & 7, 8);
+    uint32_t st[4];
+    st[0] = __byte_perm(w, prev, 0x5540); st[1] = __byte_perm(w, 0u, 0x4401); st[2] = __byte_perm(w, 0u, 0x4412); st[3] = __byte_perm(w, 0u, 0x4423);
+    TqLane r;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const uint32_t x = (st[i] & TQ_STATE_MASK) * 0x9e3779b1u;
+        r.q[i] = (int) ((uint32_t) s_lut[x >> 21] | ((uint32_t) s_lut[(x >> 10) & 2047u] << 16));
+    }
+    r.d = tq_h2f(STRATA_TQ_LD16(&b->d));
+    return r;
+}
+template<int TG, int NC>
+__device__ __forceinline__ void gu_tq_pass(const uint8_t* __restrict__ wr, const uint16_t* __restrict__ s_lut, const int4* __restrict__ s_qs,
+                                           const float* __restrict__ s_ds, int t, float (&s)[NC]) {
+    float p[4][NC];
+#pragma unroll
+    for (int v = 0; v < 4; ++v)
+#pragma unroll
+        for (int c = 0; c < NC; ++c) p[v][c] = 0.0f;
+#pragma unroll
+    for (int j = 0; j < 5; ++j) {
+#pragma unroll
+        for (int v = 0; v < 4; ++v) {
+            const int kbx = v + 4 * j;
+            const TqLane w = tq_load_f<TG>(wr, kbx, t, s_lut, (kbx & 1) != 0);
+            const int blk = kbx * 4 + (t >> 1);
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                const int4 qv = s_qs[(c * 80 + blk) * 2 + (t & 1)];
+                int sumi = 0;
+                sumi = ggml_cuda_dp4a(w.q[0], qv.x, sumi);
+                sumi = ggml_cuda_dp4a(w.q[1], qv.y, sumi);
+                sumi = ggml_cuda_dp4a(w.q[2], qv.z, sumi);
+                sumi = ggml_cuda_dp4a(w.q[3], qv.w, sumi);
+                p[v][c] += w.d * s_ds[c * 80 + blk] * (float) sumi;
+            }
+        }
+    }
+#pragma unroll
+    for (int c = 0; c < NC; ++c) {
+        s[c] = __fadd_rn(__fadd_rn(p[0][c], p[2][c]), __fadd_rn(p[1][c], p[3][c]));
+#pragma unroll
+        for (int o = 4; o > 0; o >>= 1) s[c] += __shfl_xor_sync(0xffffffffu, s[c], o);
+    }
+}
+template<int TG>
+__global__ void __launch_bounds__(256, 4) native_gu_tq_kernel(const unsigned long long* __restrict__ grp_ptr, const int32_t* __restrict__ grp_start,
+                                                           const int32_t* __restrict__ n_groups, const int32_t* __restrict__ ent_tok,
+                                                           const block_q8_1* __restrict__ xq, NativeExpertLayout L,
+                                                           float* __restrict__ gate, float* __restrict__ up) {
+    const int ng = *n_groups;
+    if (blockIdx.y >= ng) return;
+    STRATA_SHARED_ALIGN16_U32(s_lut_buf, 1024);
+    __shared__ __align__(16) int4 s_qs[GRP_NC * 80 * 2];
+    __shared__ float s_ds[GRP_NC * 80];
+    const uint16_t* s_lut = (const uint16_t*) stage_iq_grid<TG, true>(s_lut_buf, threadIdx.x, 256);
+    const int subwarp = threadIdx.x >> 3, t = threadIdx.x & 7;
+    const int row = blockIdx.x * 32 + subwarp;
+    const bool valid = row < 2 * L.n_ff;                      // gu は 1280 行＝32 の倍数で常に真。shfl を全員で呼ぶため早期 return はしない
+    const bool is_up = row >= L.n_ff;
+    const int r = is_up ? row - (int) L.n_ff : row;
+    const size_t w_off = (is_up ? L.up_off : 0) + (size_t) (valid ? r : 0) * L.gu_row;
+    float* dst = is_up ? up : gate;
+    for (int g = blockIdx.y; g < ng; g += gridDim.y) {
+        const uint8_t* wr = (const uint8_t*) grp_ptr[g] + w_off;
+        const float sc = L.tail_off ? ((const float*) (grp_ptr[g] + L.tail_off))[is_up ? 1 : 0] : 1.0f;
+        const int e0 = grp_start[g], e1 = grp_start[g + 1];
+        for (int e = e0; e < e1; e += GRP_NC) {
+            const int n = min(GRP_NC, e1 - e);
+            __syncthreads();
+            for (int u = threadIdx.x; u < n * 80; u += 256) {
+                const int i = u / 80, b = u - i * 80;
+                const uint32_t* src = reinterpret_cast<const uint32_t*>(xq + (size_t) ent_tok[e + i] * 80 + b);
+                const uint32_t dsw = src[0];
+                
+                s_ds[u] = __low2float(*reinterpret_cast<const __half2*>(&dsw)) * TQ_LUT_I8_SCALE;
+                int4 a, bq;
+                a.x = (int) src[1]; a.y = (int) src[2]; a.z = (int) src[3]; a.w = (int) src[4];
+                bq.x = (int) src[5]; bq.y = (int) src[6]; bq.z = (int) src[7]; bq.w = (int) src[8];
+                s_qs[u * 2] = a; s_qs[u * 2 + 1] = bq;
+            }
+            __syncthreads();
+            for (int i0 = 0; i0 < n; i0 += 2) {   // 3〜4 個のときは 2 個ずつ重みを復号し直す（各エントリの和は互いに独立＝ビット一致）
+                const int m = min(2, n - i0);
+                const int4* qb = s_qs + i0 * 160; const float* db = s_ds + i0 * 80;
+                if (m == 1) { float s1[1]; gu_tq_pass<TG, 1>(wr, s_lut, qb, db, t, s1); if (valid && t == 0) dst[(size_t) (e + i0) * L.n_ff + r] = s1[0] * sc; }
+                else { float s2[2]; gu_tq_pass<TG, 2>(wr, s_lut, qb, db, t, s2); if (valid && t < 2) dst[(size_t) (e + i0 + t) * L.n_ff + r] = s2[t] * sc; }
+            }
+        }
+    }
+}

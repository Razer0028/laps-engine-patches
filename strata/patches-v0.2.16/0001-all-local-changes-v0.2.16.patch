+    TqLane w4 = tq_load_d<TG>(wr, 4, t, s_lut, ((4 + rpar) & 1) != 0);
+    TqLane w2 = tq_load_d<TG>(wr, 2, t, s_lut, ((2 + rpar) & 1) != 0);
+    TqLane w1 = tq_load_d<TG>(wr, 1, t, s_lut, ((1 + rpar) & 1) != 0);
+    TqLane w3 = tq_load_d<TG>(wr, 3, t, s_lut, ((3 + rpar) & 1) != 0);
+#pragma unroll
+    for (int c = 0; c < NC; ++c) {
+        float a = 0.0f;
+        a += dn_tq_term<TG, NC>(w0, s_qs, s_ds, c, 0 * 4 + hb, t);
+        a += dn_tq_term<TG, NC>(w4, s_qs, s_ds, c, 4 * 4 + hb, t);
+        float s16 = 0.0f;
+        s16 += dn_tq_term<TG, NC>(w2, s_qs, s_ds, c, 2 * 4 + hb, t);
+        a = __fadd_rn(a, s16);

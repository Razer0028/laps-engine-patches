+SavedConversation stage_sample(const SavedConversation& first, int stage, int layers) {
+    SavedConversation s;
+    s.geometry = first.geometry;
+    s.layer_lo = 48 * stage; s.layer_hi = 48 * (stage + 1);
+    s.cvec = first.cvec;

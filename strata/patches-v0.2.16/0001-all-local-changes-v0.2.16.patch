+    s.live.imgs = first.live.imgs;
+    for (const auto& c : first.checkpoints) {
+        ConversationCheckpoint part = checkpoint(c.ids.size(), uint8_t(60 + stage));
+        part.imgs = c.imgs; part.used = c.used;

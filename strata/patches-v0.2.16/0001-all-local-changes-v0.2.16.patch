+__device__ __forceinline__ float dn_tq_term(const TqLane& w, const int4* __restrict__ s_qs, const float* __restrict__ s_ds, int c, int blk, int t) {
+    const int4 qv = s_qs[(c * 20 + blk) * 2 + (t & 1)];
+    int sumi = 0;
+    sumi = ggml_cuda_dp4a(w.q[0], qv.x, sumi);
+    sumi = ggml_cuda_dp4a(w.q[1], qv.y, sumi);
+    sumi = ggml_cuda_dp4a(w.q[2], qv.z, sumi);
+    sumi = ggml_cuda_dp4a(w.q[3], qv.w, sumi);
+    return w.d * (s_ds[c * 20 + blk] * TQ_LUT_I8_SCALE) * (float) sumi;
